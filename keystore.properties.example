# Copy this file to keystore.properties (gitignored) and fill in your own
# release signing key. Generate one with:
#
#   keytool -genkeypair -v -keystore your-release-key.jks -keyalg RSA \
#     -keysize 2048 -validity 10000 -alias your-key-alias
#
# Without this file present, `./gradlew assembleRelease` still works — it
# just produces an unsigned APK.
storeFile=your-release-key.jks
storePassword=changeit
keyAlias=your-key-alias
keyPassword=changeit
