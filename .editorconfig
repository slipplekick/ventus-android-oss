# ktlint reads this file directly (its Gradle DSL config in app/build.gradle.kts
# only covers the top-level version/android/ignoreFailures options — per-rule
# tuning like this lives here, per ktlint's own convention).
root = true

[*.{kt,kts}]
# Composable functions are conventionally PascalCase (Compose's own naming
# convention — a composable behaves like a UI component, so it's named like
# one, e.g. `VentusTheme`). Requires ktlint 1.0.1+; this project pins 1.8.0.
# See also app/build.gradle.kts' detekt{} FunctionNaming note.
ktlint_function_naming_ignore_when_annotated_with = Composable
